.{
    .name = "joe-installer",
    .version = "0.1",
    .release = 7,
    .description = "The graphical installer of joe Linux's installation medium",
    .license = "MIT",
    // Only the live medium has it (joe-live); nothing builds against it.
    .build_only = true,
    .depends = .{ "glibc", "gcc", "qt6", "dave", "polkit", "systemd", "adwaita-fonts", "pour" },
    .build_depends = .{ "cmake", "ninja", "qt6" },
}
