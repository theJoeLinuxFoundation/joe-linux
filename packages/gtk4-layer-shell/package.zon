.{
    .name = "gtk4-layer-shell",
    .version = "1.3.0",
    .release = 1,
    .description = "Lets GTK 4 programs be desktop panels and overlays on Wayland (layer shell)",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://github.com/wmww/gtk4-layer-shell/archive/v1.3.0/gtk4-layer-shell-1.3.0.tar.gz", .sha256 = "1ebb01ab14e98afd1727f68f64981c37bd23305b1f131f5667c02b94cf593192" },
    },
    // glib provides g-ir-scanner as well.
    .depends = .{ "glibc", "gtk4", "glib", "wayland" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "wayland-protocols", "vala" },
}
