.{
    .name = "dave",
    .version = "0.4.0",
    .release = 2,
    .description = "The joe Linux package manager and deployment tool",
    .license = "MIT",
    .depends = .{"systemd"},
    // dave installs, upgrades and seals the whole system as root.
    .operations = .{
        .{ .programs = .{ "usr/bin/dave" }, .allow = .{"all"} },
    },
}
