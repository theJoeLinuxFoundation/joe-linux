.{
    .name = "unbound",
    .version = "1.26.2",
    .release = 2,
    .description = "Validating, recursive and caching DNS resolver, with libunbound",
    .license = "BSD-3-Clause",
    .sources = .{
        .{ .url = "https://nlnetlabs.nl/downloads/unbound/unbound-1.26.2.tar.gz", .sha256 = "d8ee7aa6bbb3ff1be7d9e57637d0d0ec2f18273a8efff1a0afe2c665858b96f7" },
    },
    .depends = .{ "glibc", "openssl", "libevent", "expat", "nghttp2", "systemd" },
    .build_depends = .{"pkgconf"},
    .operations = .{
        // The resolver binds DNS sockets as root, then drops to unbound.
        // The separate trust-anchor unit starts as unbound and needs no
        // privileged operations. Its public CLI also supports custom keys.
        .{ .programs = .{"usr/sbin/unbound"}, .allow = .{ "net", "cap:net_bind_service", "cap:setgid", "cap:setuid" } },
        .{ .programs = .{"usr/libexec/unbound-anchor"}, .allow = .{"none"} },
    },
}
