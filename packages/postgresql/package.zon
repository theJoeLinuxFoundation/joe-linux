.{
    .name = "postgresql",
    .version = "18.7",
    .release = 2,
    .description = "PostgreSQL object-relational database server, client programs and libpq",
    .license = "PostgreSQL",
    .sources = .{
        .{ .url = "https://ftp.postgresql.org/pub/source/v18.7/postgresql-18.7.tar.bz2", .sha256 = "441dfae4280cae3e0425e5f876f80559fb0731c140f1aae22b3e5a54d0411bfd" },
    },
    // util-linux: libuuid for contrib/uuid-ossp. tzdata is read at run time
    // from /usr/share/zoneinfo.
    .depends = .{ "glibc", "openssl", "icu", "libxml2", "libxslt", "linux-pam", "krb5", "lz4", "zstd", "zlib", "readline", "util-linux", "tzdata" },
    // The manual pages are made with xsltproc and the DocBook stylesheets.
    .build_depends = .{ "tzdata", "pkgconf", "perl", "bison", "flex", "gettext", "libxslt", "docbook-xml", "docbook-xsl-nons" },
    .operations = .{
        // systemd runs pg_ctl and its postgres children as postgres, with no
        // capabilities. The server refuses to start as root.
        .{ .programs = .{ "usr/bin/pg_ctl", "usr/bin/postgres" }, .allow = .{"none"} },
    },
}
