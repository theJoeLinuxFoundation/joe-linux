.{
    .name = "nftables",
    .version = "1.1.7",
    .release = 2,
    .description = "Netfilter tables: the nft firewall tool and the libnftables library",
    .license = "GPL-2.0-only AND GPL-2.0-or-later",
    .sources = .{
        .{ .url = "https://netfilter.org/projects/nftables/files/nftables-1.1.7.tar.xz", .sha256 = "a6fbf060d8d4fff001517a2b94f356bb4366bfbf0ba366366f9d27cc38caa58f" },
    },
    .depends = .{ "glibc", "libmnl", "libnftnl", "gmp", "readline", "jansson" },
    .build_depends = .{ "pkgconf", "flex", "bison" },
    .operations = .{
        // The oneshot loads and flushes kernel rules through netlink.
        // The interactive nft client can also write the caller's history.
        .{ .programs = .{"usr/libexec/nft"}, .allow = .{"cap:net_admin"} },
    },
}
