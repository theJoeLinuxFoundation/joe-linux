.{
    .name = "swaylock",
    .version = "1.8.6",
    .release = 1,
    .description = "Screen locker for Wayland compositors with the session-lock protocol",
    .license = "MIT",
    .sources = .{
        .{ .url = "https://github.com/swaywm/swaylock/releases/download/v1.8.6/swaylock-1.8.6.tar.gz", .sha256 = "a15154348fef852fdb224112d137c393c826478b777f63479beb15e8d3812eaf" },
    },
    // linux-pam: the password is checked through PAM, as the user, by
    // pam_unix's setuid helper; swaylock itself has no privilege.
    .depends = .{ "glibc", "wayland", "libxkbcommon", "cairo", "gdk-pixbuf", "linux-pam" },
    .build_depends = .{ "meson", "ninja", "pkgconf", "wayland-protocols" },
}
